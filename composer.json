{
    "name": "pdir/contao-workmate-agent-bundle",
    "description": "Workmate agent for Contao projects: commits the database backup and composer.lock before and after a Contao update",
    "license": "LGPL-3.0-or-later",
    "type": "contao-bundle",
    "authors": [
        {
            "name": "pdir GmbH",
            "homepage": "https://pdir.de",
            "email": "develop@pdir.de",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "contao/core-bundle": "^4.13 || ^5.0",
        "symfony/config": "^5.4 || ^6.4 || ^7.0",
        "symfony/dependency-injection": "^5.4 || ^6.4 || ^7.0",
        "symfony/http-foundation": "^5.4 || ^6.4 || ^7.0",
        "symfony/http-kernel": "^5.4 || ^6.4 || ^7.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0",
        "phpunit/phpunit": "^9.5"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "bin": [
        "bin/workmate-agent-check"
    ],
    "autoload": {
        "psr-4": {
            "Pdir\\ContaoWorkmateAgentBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pdir\\ContaoWorkmateAgentBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": true,
            "contao/manager-plugin": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "contao-manager-plugin": "Pdir\\ContaoWorkmateAgentBundle\\ContaoManager\\Plugin"
    }
}
